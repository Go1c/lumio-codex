# 复制为 .env 后按需修改。.env 已被仓库根 .gitignore 忽略，切勿提交真实密钥。

# —— 基础 ——
CCHAVEN_ENV=dev
CCHAVEN_HTTP_ADDR=:8080
# 官网地址，用于拼接邀请链接、邮件里的重设链接与支付回跳，同时作为 CORS 可信来源。
CCHAVEN_PUBLIC_URL=http://localhost:5173
# 管理后台地址。后台是独立部署的前端（生产为 https://admin.cchaven.cn），不是官网的子路径，
# 必须单独列为可信来源，否则后台在生产环境拿不到 CORS 头，且所有写操作都会被同源校验判成 403。
# dev 下留空会自动用 apps/admin 的 vite 端口；生产环境留空则服务启动时会打出告警。
CCHAVEN_ADMIN_URL=http://localhost:5183

# —— 会话 cookie ——
# SameSite 策略，取值 lax（默认）或 none。怎么选看「控制面与前端是不是同站」：
#   lax  —— 同站部署，即控制面与前端的 eTLD+1 相同（cchaven.cn / admin.cchaven.cn / api.cchaven.cn
#           都是 cchaven.cn）。顶层导航照常带 cookie，跨站表单提交天然带不上，最安全，保持 lax。
#   none —— 控制面被放在另一个站点（不同 eTLD+1，例如前端在 cchaven.cn、控制面在 cchaven-api.com，
#           或前端托管在 *.vercel.app）。此时 lax 会让浏览器根本不发送 cookie，登录直接失效。
# 配成 none 时服务会强制 Secure=true（浏览器的硬性要求），控制面必须走 HTTPS，否则 cookie 会被丢弃。
CCHAVEN_COOKIE_SAMESITE=lax

# —— 数据库 ——
CCHAVEN_DATABASE_URL=postgres://cchaven:cchaven@localhost:5432/cchaven?sslmode=disable

# —— 密钥（生产环境必填，且每个至少 32 字节）——
# 生成方式：openssl rand -base64 48
CCHAVEN_JWT_SECRET=
CCHAVEN_CODE_PEPPER=
CCHAVEN_TOTP_KEY=

# —— 令牌有效期 ——
CCHAVEN_ACCESS_TOKEN_TTL=15m
CCHAVEN_REFRESH_TOKEN_TTL=1440h
CCHAVEN_ADMIN_SESSION_TTL=12h

# —— 邮件（留空时邮件只入 email_outbox 不实际投递）——
CCHAVEN_SMTP_HOST=
CCHAVEN_SMTP_PORT=587
CCHAVEN_SMTP_USERNAME=
CCHAVEN_SMTP_PASSWORD=
CCHAVEN_SMTP_FROM=CC避风港 <no-reply@cchaven.cn>

# —— 测试 ——
# 设置后测试直接连这个库，不再拉起 embedded-postgres。
# 使用 docker-compose 的测试库时：
# CCHAVEN_TEST_DATABASE_URL=postgres://cchaven:cchaven@localhost:5433/cchaven_test?sslmode=disable
