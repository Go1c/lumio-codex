{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BestCodex",
  "version": "1.2.46",
  "identifier": "games.lumio.codex",
  "build": {
    "beforeDevCommand": "node ../../scripts/sync-components/stage.mjs --dev && npm run vite:dev",
    "beforeBuildCommand": "node ../../scripts/sync-components/stage.mjs --dev && npm run vite:build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "label": "main",
        "title": "BestCodex",
        "width": 1180,
        "height": 820,
        "minWidth": 960,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/fns-agent"],
    "resources": {
      "resources/remote/linux-x86_64/fns-server": "remote/linux-x86_64/fns-server",
      "resources/remote/linux-x86_64/fns-agent": "remote/linux-x86_64/fns-agent",
      "resources/remote/linux-x86_64/release-provenance.json": "remote/linux-x86_64/release-provenance.json"
    }
  }
}
